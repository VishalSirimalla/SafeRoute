# SafeRoute Backend Environment Configuration

# Database
MONGO_URI=mongodb+srv://user:pass@cluster.mongodb.net/saferoute?retryWrites=true&w=majority

# Auth & Security
JWT_SECRET=saferoute-production-secret-key-2026

# Email Notifications (Nodemailer SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=user@example.com
SMTP_PASS=your-app-password
SMTP_FROM=SafeRoute Alerts <noreply@saferoute.app>
SMTP_SECURE=false

# SMS Notifications (Twilio)
# Note for India: Programmatic SMS requires approved DLT Registration & Header/Template config.
TWILIO_ACCOUNT_SID=ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_FROM_NUMBER=+15550199200

# Map Services
NOMINATIM_EMAIL=user@example.com
VITE_GEOAPIFY_API_KEY=your_geoapify_key
